{
  "name": "parkruneventsummary",
  "version": "1.0.3",
  "description": "A tool for Run Directors or interested third parties to generate a nice infographic for sharing.",
  "main": "script.js",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{js,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,css,json,md}\"",
    "lint": "eslint src/script.js src/lib/results-page.js src/lib/results-page.test.js",
    "build": "rm pes.xpi;zip -u -8 -v -r pes.zip manifest.json src i;cp pes.zip pes.xpi;"
  },
  "author": "Rich Boakes <rich@boakes.org>",
  "license": "ISC",
  "devDependencies": {
    "eslint": "^8.54.0",
    "eslint-config-portsoc": "^1.0.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "vitest": "^3.0.5"
  },
  "eslintConfig": {
    "extends": "portsoc",
    "root": true,
    "env": {
      "browser": true
    },
    "globals": {
      "parkrunResultsPage": "readonly",
      "chrome": "readonly",
      "Chart": "readonly",
      "ChartDataLabels": "readonly"
    },
    "overrides": [
      {
        "files": ["**/*.test.js"],
        "env": {
          "node": true
        },
        "globals": {
          "describe": "readonly",
          "it": "readonly",
          "expect": "readonly",
          "beforeAll": "readonly"
        }
      }
    ]
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all"
  }
}
